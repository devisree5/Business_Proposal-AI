# ====================================================
# ProposalGen AI - Environment Configuration
# ====================================================

# Application Environment
ENVIRONMENT=development

# Database Configuration (PostgreSQL on Render/Production, SQLite locally)
DATABASE_URL=sqlite:///./proposalgen.db
# DATABASE_URL=postgresql://user:password@hostname:5432/proposalgen

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Gmail API OAuth 2.0 (Optional for live Gmail ingestion)
GMAIL_CLIENT_ID=your_gmail_client_id
GMAIL_CLIENT_SECRET=your_gmail_client_secret
GMAIL_REFRESH_TOKEN=your_gmail_refresh_token

# IMAP Configuration (Optional for live inbox sync)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=your_email@domain.com
IMAP_PASSWORD=your_email_app_password

# SMTP / Outbound Email Delivery
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@domain.com
SMTP_PASSWORD=your_email_app_password
SMTP_FROM=proposals@proposalgen.ai

# Company Profile Default Information
COMPANY_NAME=ProposalGen Solutions Inc.
COMPANY_EMAIL=sales@proposalgen.ai
COMPANY_PHONE=+1 (800) 555-0199
COMPANY_WEBSITE=https://proposalgen.ai
COMPANY_ADDRESS=100 Innovation Way, Suite 400, San Francisco, CA 94107
